# Copy to .env (never commit .env). Only names, no values that identify an account.
AWS_PROFILE=pathfinder
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
S3_BUCKET=your-private-bucket
# Optional: Hugging Face token for the gated UNI weights (export in the shell instead of writing it here)
# HF_TOKEN=
